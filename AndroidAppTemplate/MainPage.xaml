<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AndroidAppTemplate.MainPage" >

    <ScrollView>
        <Grid>
            
            <Label 
                Text="HIIIII :3"
                x:Name="LabelA"
                HorizontalOptions="Center"
            />
            <Button
                Text="Button"
                x:Name="Button"
                Clicked="Button_OnClicked"
                WidthRequest="100"
                HeightRequest="100"
                HorizontalOptions="Center"
                VerticalOptions="Center"
            />
            <Button 
                Margin="0,500,0,0"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Clicked="send_notification" 
                    Text="Press to send notifications" 
                    WidthRequest="300" 
                    HeightRequest="100" 
                
                ></Button>
            
        </Grid>
    </ScrollView>

</ContentPage>
